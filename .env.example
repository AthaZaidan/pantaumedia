APP_NAME="SOSPEM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com
FORCE_HTTPS=true

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Utama Hosting (PostgreSQL disarankan; juga mendukung MySQL/SQLite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sospem
DB_USERNAME=postgres
DB_PASSWORD=

# SESSION_DRIVER=database (atau file jika shared hosting sederhana)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sospem.id"
MAIL_FROM_NAME="${APP_NAME}"

# Akun Admin Awal SOSPEM (Otomatis dibuat saat halaman /login pertama kali dibuka jika tabel users kosong)
ADMIN_NAME="Admin SOSPEM"
ADMIN_EMAIL=admin@sospem.id
ADMIN_PASSWORD=ganti-dengan-sandi-kuat

# Konfigurasi AI Chatbot (Opsional — jika kosong, otomatis memakai gateway AI gratis + Google News RSS + Open-Meteo)
LOCAL_AGENT_URL=http://127.0.0.1:11434/api/chat
LOCAL_AGENT_MODEL=qwen2.5:3b
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
